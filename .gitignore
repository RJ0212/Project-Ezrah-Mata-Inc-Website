# OS-generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Node (not currently used — Tailwind loads via CDN, no build step —
# but harmless to have ready if you add local tooling, a dev server,
# or tests later)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/

# Environment / secrets (if you ever add a contact-form backend,
# analytics keys, API keys, etc. — never commit these)
.env
.env.local
.env.*.local

# Build output (only relevant if you move off the Tailwind CDN to a
# local build later)
dist/
build/
.cache/

# Logs & temp files
*.log
*.tmp
*.bak
